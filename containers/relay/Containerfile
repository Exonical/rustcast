# Build context: repository root.
ARG GO_IMAGE=docker.io/library/golang:1.27
ARG NODE_IMAGE=docker.io/library/node:lts
ARG ROCKY_IMAGE=docker.io/rockylinux/rockylinux:10-minimal

FROM ${NODE_IMAGE} AS ui
RUN corepack enable && corepack prepare pnpm@12.9.1 --activate
WORKDIR /ui
COPY flux-web/ui/package.json flux-web/ui/pnpm-lock.yaml flux-web/ui/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY flux-web/ui/ ./
RUN pnpm build

FROM ${GO_IMAGE} AS relay
WORKDIR /src
COPY flux-web/go.mod flux-web/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY flux-web/*.go ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/flux-web .

FROM ${ROCKY_IMAGE}
RUN useradd --system --create-home --home-dir /app flux-web \
    && mkdir -p /var/lib/flux-relay && chown flux-web:flux-web /var/lib/flux-relay
WORKDIR /app
COPY --from=relay /out/flux-web /app/flux-web
COPY --from=ui /ui/out /app/ui/out
USER flux-web
# HTTP UI/API
EXPOSE 8080/tcp
EXPOSE 9101/tcp
# HTTP/3 WebTransport
EXPOSE 8443/udp
ENTRYPOINT ["/app/flux-web"]
