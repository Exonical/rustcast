#!/bin/bash
# Persist FLUX_* / RUST_LOG from the container's PID 1 environment for the systemd units.
set -eu
mkdir -p /etc/flux
env_of_init() { tr '\0' '\n' < /proc/1/environ; }
get() { env_of_init | sed -n "s/^$1=//p" | head -n1; }
{
  echo "FLUX_DISPLAY_SIZE=$(get FLUX_DISPLAY_SIZE | grep . || echo 1920x1080)"
  echo "FLUX_DISPLAY_REFRESH=$(get FLUX_DISPLAY_REFRESH | grep . || echo 60)"
  echo "FLUX_RELAY_URL=$(get FLUX_RELAY_URL | grep . || echo http://127.0.0.1:8080)"
  echo "FLUX_ADVERTISE_HOST=$(get FLUX_ADVERTISE_HOST | grep . || echo 127.0.0.1)"
  echo "RUST_LOG=$(get RUST_LOG | grep . || echo info)"
  token=$(get FLUX_RELAY_TOKEN || true)
  if [ -n "$token" ]; then echo "FLUX_RELAY_TOKEN=$token"; fi
  enroll=$(get FLUX_AK_ENROLLMENT_TOKEN || true)
  if [ -n "$enroll" ]; then echo "FLUX_AK_ENROLLMENT_TOKEN=$enroll"; fi
  name=$(get FLUX_NAME || true)
  if [ -n "$name" ]; then echo "FLUX_NAME=$name"; fi
  api=$(get FLUX_CAPTURE_API || true)
  if [ -n "$api" ]; then echo "FLUX_CAPTURE_API=$api"; fi
} > /etc/flux/env
# Local test user password, injected at container start (never baked in).
devpw=$(get FLUX_DEVUSER_PASSWORD || true)
if [ -n "$devpw" ]; then echo "devuser:$devpw" | chpasswd; fi

# pam_authentik interactive auth needs an Authentik Enterprise license; unlicensed
# it answers with a hard auth error that blocks pam_unix/pam_sss. Off by default.
if [ "$(get FLUX_PAM_AUTHENTIK || true)" != "true" ]; then
  sed -i '/pam_authentik\.so/d' /etc/pam.d/flux
fi

# SSSD talks to the pod-local Authentik LDAP outpost. The bind password is
# rendered at boot so it never lands in the image. FLUX_LDAP_URI can point at
# an ldaps:// endpoint in production.
ldap_pw=$(get FLUX_LDAP_BIND_PASSWORD || true)
ldap_uri=$(get FLUX_LDAP_URI || true)
ldap_uri=${ldap_uri:-ldap://127.0.0.1:3389}
if [ -n "$ldap_pw" ]; then
  umask 077
  cat > /etc/sssd/sssd.conf <<SSSDEOF
[sssd]
services = nss, pam
domains = authentik

[domain/authentik]
id_provider = ldap
auth_provider = ldap
ldap_uri = $ldap_uri
ldap_search_base = dc=ldap,dc=goauthentik,dc=io
ldap_schema = rfc2307bis
ldap_user_object_class = user
ldap_user_name = cn
ldap_user_uid_number = uidNumber
ldap_user_gid_number = gidNumber
ldap_user_home_directory = homeDirectory
ldap_group_object_class = group
ldap_group_name = cn
ldap_group_member = member
ldap_default_bind_dn = cn=ldapservice,ou=users,dc=ldap,dc=goauthentik,dc=io
ldap_default_authtok = $ldap_pw
ldap_id_use_start_tls = false
ldap_auth_disable_tls_never_use_in_production = true
cache_credentials = false
enumerate = false
use_fully_qualified_names = false
default_shell = /bin/bash
override_homedir = /home/%u
SSSDEOF
  chmod 600 /etc/sssd/sssd.conf
fi
